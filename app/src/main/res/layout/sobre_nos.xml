<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conatiner_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TableLayout
        android:id="@+id/tb0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <TableRow
            android:id="@+id/tr0"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/lLy0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageV1"
                    android:layout_width="285dp"
                    android:layout_height="126dp"
                    android:layout_weight="20"
                    tools:src="@drawable/icone_semTexto" />

                <LinearLayout
                    android:id="@+id/lLy01"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="20"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Bem Vindo"
                        android:textAlignment="textStart"
                        android:textColor="#040404"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Feedback Juvenil"
                        android:textAlignment="textStart"
                        android:textColor="#090909"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </TableRow>

        <TableRow
            android:id="@+id/tr1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/lLy1"
                android:layout_width="100dp"
                android:layout_height="190dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="396dp"
                    android:layout_height="wrap_content"
                    android:text="Contactos"
                    android:textColor="#000000"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="396dp"
                    android:layout_height="38dp"
                    android:text="Numeros: 87............."
                    android:textColor="#000000"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="402dp"
                    android:layout_height="wrap_content"
                    android:text="Email: fj......"
                    android:textColor="#090909"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="404dp"
                    android:layout_height="wrap_content"
                    android:text="Localização (Moçambique, Maputo, Distrito de Marracuene)"
                    android:textAlignment="viewStart"
                    android:textColor="#0D0C0C"
                    android:textSize="24sp" />
            </LinearLayout>

        </TableRow>

        <TableRow
            android:id="@+id/tr2"
            android:layout_width="match_parent"
            android:layout_height="277dp">

            <LinearLayout
                android:id="@+id/lLy2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="408dp"
                    android:layout_height="wrap_content"
                    android:text="Biografia"
                    android:textColor="#121212"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="397dp"
                    android:layout_height="200dp"
                    android:fitsSystemWindows="true"
                    android:singleLine="false"
                    android:text="A Feedback Juvenil é uma multi-plataforma de midia digital
                        inovador, criado para dar voz a juventude, valorizar a cultura e impulsionar
                        o desenvolvimento comunitario. **A Nossa Missão** Conectar, informare engajar
                        as novas gerações através de conteúdos dinâmicos que abordam desde a atualidade,
                        desporto e cultura até debates aprofundados sobre os temas que moldam o nosso
                        futuro. Acreditamos que a informação livre, criativa e plural é a chave para
                         a transformação social. **O Nosso Lema** &quot;Juntos, o futuro é de ouro.&quot;"
                    android:textAlignment="inherit"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="20sp" />

            </LinearLayout>

        </TableRow>

    </TableLayout>

</LinearLayout>